struct MemoryMapState {
  phase: u32,
  expected_descriptors: u64,
  accepted_descriptors: u64,
  last_end: u64,
  usable_pages: u64,
} inv phase <= 2 && accepted_descriptors <= expected_descriptors &&
      usable_pages <= 1099511627776 &&
      (accepted_descriptors != 0 || last_end == 0)

enum MemoryMapEvent {
  Header {
    descriptor_size: u64,
    descriptor_version: u32,
    descriptor_count: u64,
    raw_size: u64,
  },
  Descriptor {
    memory_type: u32,
    physical_start: u64,
    page_count: u64,
    cache_class: u32,
    runtime: bool,
    attributes_known: bool,
  },
  Finish,
}

enum MemoryMapAction {
  HeaderAccepted,
  RangeAccepted { kind: u32 },
  Complete,
  Reject { code: u32 },
}

fn memory_map_step(state: MemoryMapState, event: MemoryMapEvent)
  -> (MemoryMapState, MemoryMapAction)
  req true
  ens result.0.phase >= state.phase
  ens result.0.phase <= 2
  ens result.0.accepted_descriptors <= result.0.expected_descriptors
  ens result.0.usable_pages <= 1099511627776
  ens match result.1 {
    MemoryMapAction::HeaderAccepted =>
      state.phase == 0 && result.0.phase == 1 &&
      result.0.accepted_descriptors == 0 && result.0.last_end == 0 &&
      result.0.usable_pages == 0,
    MemoryMapAction::RangeAccepted { kind } =>
      state.phase == 1 && result.0.phase == 1 && kind >= 1 && kind <= 9 &&
      result.0.expected_descriptors == state.expected_descriptors &&
      result.0.accepted_descriptors == state.accepted_descriptors + 1 &&
      result.0.last_end > state.last_end &&
      result.0.usable_pages >= state.usable_pages,
    MemoryMapAction::Complete =>
      state.phase == 1 && result.0.phase == 2 &&
      result.0.expected_descriptors == state.expected_descriptors &&
      result.0.accepted_descriptors == state.accepted_descriptors &&
      result.0.last_end == state.last_end &&
      result.0.usable_pages == state.usable_pages,
    MemoryMapAction::Reject { code } =>
      code != 0 && result.0.phase == state.phase &&
      result.0.expected_descriptors == state.expected_descriptors &&
      result.0.accepted_descriptors == state.accepted_descriptors &&
      result.0.last_end == state.last_end &&
      result.0.usable_pages == state.usable_pages,
  }
  ens match event {
    MemoryMapEvent::Header {
      descriptor_size,
      descriptor_version,
      descriptor_count,
      raw_size
    } => match result.1 {
      MemoryMapAction::HeaderAccepted =>
        state.phase == 0 && descriptor_size >= 40 &&
        descriptor_size <= 256 && (descriptor_size & 7) == 0 &&
        descriptor_version == 1 && descriptor_count >= 1 &&
        descriptor_count <= 4096 && raw_size <= 1048576 &&
        raw_size / descriptor_size == descriptor_count &&
        raw_size % descriptor_size == 0 &&
        result.0.expected_descriptors == descriptor_count,
      MemoryMapAction::RangeAccepted { kind } => false,
      MemoryMapAction::Complete => false,
      MemoryMapAction::Reject { code } =>
        code == if state.phase != 0 {
          1 as u32
        } else {
          if descriptor_size < 40 || descriptor_size > 256 ||
             (descriptor_size & 7) != 0 || descriptor_version != 1 ||
             descriptor_count < 1 || descriptor_count > 4096 ||
             raw_size > 1048576 ||
             raw_size / descriptor_size != descriptor_count ||
             raw_size % descriptor_size != 0 {
            2 as u32
          } else {
            0 as u32
          }
        },
    },
    MemoryMapEvent::Descriptor {
      memory_type,
      physical_start,
      page_count,
      cache_class,
      runtime,
      attributes_known
    } => match result.1 {
      MemoryMapAction::HeaderAccepted => false,
      MemoryMapAction::RangeAccepted { kind } =>
        state.phase == 1 &&
        state.accepted_descriptors < state.expected_descriptors &&
        page_count != 0 && page_count <= 1099511627776 &&
        (physical_start & 4095) == 0 &&
        physical_start <= 0x0010_0000_0000_0000 - page_count * 4096 &&
        (state.accepted_descriptors == 0 ||
         physical_start >= state.last_end) &&
        memory_type <= 15 && cache_class <= 5 && attributes_known &&
        !((memory_type == 7 || memory_type == 11 || memory_type == 12) &&
          cache_class == 0) &&
        (!(memory_type == 5 || memory_type == 6) || runtime) &&
        (!runtime || memory_type == 5 || memory_type == 6 ||
         memory_type == 11 || memory_type == 12) &&
        (memory_type != 7 ||
         page_count <= 1099511627776 - state.usable_pages) &&
        kind == if memory_type == 1 || memory_type == 2 {
          2 as u32
        } else {
          if memory_type == 3 || memory_type == 4 {
            3 as u32
          } else {
            if memory_type == 7 {
              4 as u32
            } else {
              if memory_type == 8 {
                5 as u32
              } else {
                if memory_type == 9 {
                  6 as u32
                } else {
                  if memory_type == 10 {
                    7 as u32
                  } else {
                    if memory_type == 11 || memory_type == 12 {
                      8 as u32
                    } else {
                      if memory_type == 14 { 9 as u32 } else { 1 as u32 }
                    }
                  }
                }
              }
            }
          }
        } &&
        result.0.last_end == physical_start + page_count * 4096 &&
        ((memory_type == 7 &&
          result.0.usable_pages == state.usable_pages + page_count) ||
         (memory_type != 7 &&
          result.0.usable_pages == state.usable_pages)),
      MemoryMapAction::Complete => false,
      MemoryMapAction::Reject { code } =>
        code == if state.phase != 1 {
          10 as u32
        } else {
          if state.accepted_descriptors >= state.expected_descriptors {
            11 as u32
          } else {
            if page_count == 0 || page_count > 1099511627776 ||
               (physical_start & 4095) != 0 ||
               physical_start >
                 0x0010_0000_0000_0000 - page_count * 4096 ||
               (state.accepted_descriptors != 0 &&
                physical_start < state.last_end) {
              12 as u32
            } else {
              if memory_type > 15 || cache_class > 5 || !attributes_known ||
                 ((memory_type == 7 || memory_type == 11 ||
                   memory_type == 12) && cache_class == 0) ||
                 ((memory_type == 5 || memory_type == 6) && !runtime) ||
                 (runtime && memory_type != 5 && memory_type != 6 &&
                  memory_type != 11 && memory_type != 12) ||
                 (memory_type == 7 &&
                  page_count > 1099511627776 - state.usable_pages) {
                13 as u32
              } else {
                0 as u32
              }
            }
          }
        },
    },
    MemoryMapEvent::Finish => match result.1 {
      MemoryMapAction::HeaderAccepted => false,
      MemoryMapAction::RangeAccepted { kind } => false,
      MemoryMapAction::Complete =>
        state.phase == 1 &&
        state.accepted_descriptors == state.expected_descriptors &&
        state.usable_pages != 0,
      MemoryMapAction::Reject { code } =>
        code == if state.phase == 1 &&
                   state.accepted_descriptors == state.expected_descriptors &&
                   state.usable_pages != 0 {
          0 as u32
        } else {
          20 as u32
        },
    },
  }
  fx pure
{
  match event {
    MemoryMapEvent::Header {
      descriptor_size,
      descriptor_version,
      descriptor_count,
      raw_size
    } =>
      if state.phase != 0 {
        (state, MemoryMapAction::Reject { code: 1 })
      } else {
        if descriptor_size < 40 || descriptor_size > 256 ||
           (descriptor_size & 7) != 0 || descriptor_version != 1 ||
           descriptor_count < 1 || descriptor_count > 4096 ||
           raw_size > 1048576 ||
           raw_size / descriptor_size != descriptor_count ||
           raw_size % descriptor_size != 0 {
          (state, MemoryMapAction::Reject { code: 2 })
        } else {
          (MemoryMapState {
            phase: 1,
            expected_descriptors: descriptor_count,
            accepted_descriptors: 0,
            last_end: 0,
            usable_pages: 0,
          }, MemoryMapAction::HeaderAccepted)
        }
      },
    MemoryMapEvent::Descriptor {
      memory_type,
      physical_start,
      page_count,
      cache_class,
      runtime,
      attributes_known
    } =>
      if state.phase != 1 {
        (state, MemoryMapAction::Reject { code: 10 })
      } else {
        if state.accepted_descriptors >= state.expected_descriptors {
          (state, MemoryMapAction::Reject { code: 11 })
        } else {
          if page_count == 0 || page_count > 1099511627776 ||
             (physical_start & 4095) != 0 ||
             physical_start >
               0x0010_0000_0000_0000 - page_count * 4096 ||
             (state.accepted_descriptors != 0 &&
              physical_start < state.last_end) {
            (state, MemoryMapAction::Reject { code: 12 })
          } else {
            if memory_type > 15 || cache_class > 5 || !attributes_known ||
               ((memory_type == 7 || memory_type == 11 ||
                 memory_type == 12) && cache_class == 0) ||
               ((memory_type == 5 || memory_type == 6) && !runtime) ||
               (runtime && memory_type != 5 && memory_type != 6 &&
                memory_type != 11 && memory_type != 12) ||
               (memory_type == 7 &&
                page_count > 1099511627776 - state.usable_pages) {
              (state, MemoryMapAction::Reject { code: 13 })
            } else {
              (MemoryMapState {
                phase: 1,
                expected_descriptors: state.expected_descriptors,
                accepted_descriptors: state.accepted_descriptors + 1,
                last_end: physical_start + page_count * 4096,
                usable_pages: if memory_type == 7 {
                  state.usable_pages + page_count
                } else {
                  state.usable_pages
                },
              }, MemoryMapAction::RangeAccepted {
                kind: if memory_type == 1 || memory_type == 2 {
                  2
                } else {
                  if memory_type == 3 || memory_type == 4 {
                    3
                  } else {
                    if memory_type == 7 {
                      4
                    } else {
                      if memory_type == 8 {
                        5
                      } else {
                        if memory_type == 9 {
                          6
                        } else {
                          if memory_type == 10 {
                            7
                          } else {
                            if memory_type == 11 || memory_type == 12 {
                              8
                            } else {
                              if memory_type == 14 { 9 } else { 1 }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              })
            }
          }
        }
      },
    MemoryMapEvent::Finish =>
      if state.phase == 1 &&
         state.accepted_descriptors == state.expected_descriptors &&
         state.usable_pages != 0 {
        (MemoryMapState {
          phase: 2,
          expected_descriptors: state.expected_descriptors,
          accepted_descriptors: state.accepted_descriptors,
          last_end: state.last_end,
          usable_pages: state.usable_pages,
        }, MemoryMapAction::Complete)
      } else {
        (state, MemoryMapAction::Reject { code: 20 })
      },
  }
}

struct FirmwareExitState {
  phase: u32,
  map_attempts: u32,
  exit_retries: u32,
  capacity: u64,
  map_key: u64,
  descriptor_count: u64,
} inv phase <= 3 && map_attempts <= 8 && exit_retries <= 4 &&
      ((phase == 0 && map_key == 0 && descriptor_count == 0) ||
       (phase != 0 && map_key != 0 && descriptor_count != 0))

enum FirmwareExitEvent {
  MapResult {
    status: u32,
    required_size: u64,
    returned_size: u64,
    descriptor_size: u64,
    descriptor_version: u32,
    descriptor_count: u64,
    map_key: u64,
    capacity: u64,
  },
  ExitResult {
    status: u32,
    map_key: u64,
  },
  Finish,
}

enum FirmwareExitAction {
  Resize { capacity: u64 },
  MapAccepted,
  Reacquire,
  ExitAccepted,
  Complete,
  Reject { code: u32 },
}

fn firmware_exit_step(state: FirmwareExitState, event: FirmwareExitEvent)
  -> (FirmwareExitState, FirmwareExitAction)
  req true
  ens match result.1 {
    FirmwareExitAction::Reacquire => true,
    FirmwareExitAction::Resize { capacity } => result.0.phase >= state.phase,
    FirmwareExitAction::MapAccepted => result.0.phase >= state.phase,
    FirmwareExitAction::ExitAccepted => result.0.phase >= state.phase,
    FirmwareExitAction::Complete => result.0.phase >= state.phase,
    FirmwareExitAction::Reject { code } => result.0.phase >= state.phase,
  }
  ens result.0.phase <= 3
  ens result.0.map_attempts <= 8
  ens result.0.exit_retries <= 4
  ens match result.1 {
    FirmwareExitAction::Resize { capacity } =>
      state.phase == 0 && result.0.phase == 0 &&
      result.0.map_attempts == state.map_attempts + 1 &&
      result.0.exit_retries == state.exit_retries &&
      result.0.capacity == capacity && capacity > state.capacity &&
      result.0.map_key == 0 && result.0.descriptor_count == 0,
    FirmwareExitAction::MapAccepted =>
      state.phase == 0 && result.0.phase == 1 &&
      result.0.map_attempts == state.map_attempts + 1 &&
      result.0.exit_retries == state.exit_retries &&
      result.0.capacity == state.capacity && result.0.map_key != 0 &&
      result.0.descriptor_count != 0,
    FirmwareExitAction::Reacquire =>
      state.phase == 1 && result.0.phase == 0 &&
      result.0.map_attempts == state.map_attempts &&
      result.0.exit_retries == state.exit_retries + 1 &&
      result.0.capacity == state.capacity && result.0.map_key == 0 &&
      result.0.descriptor_count == 0,
    FirmwareExitAction::ExitAccepted =>
      state.phase == 1 && result.0.phase == 2 &&
      result.0.map_attempts == state.map_attempts &&
      result.0.exit_retries == state.exit_retries &&
      result.0.capacity == state.capacity &&
      result.0.map_key == state.map_key &&
      result.0.descriptor_count == state.descriptor_count,
    FirmwareExitAction::Complete =>
      state.phase == 2 && result.0.phase == 3 &&
      result.0.map_attempts == state.map_attempts &&
      result.0.exit_retries == state.exit_retries &&
      result.0.capacity == state.capacity &&
      result.0.map_key == state.map_key &&
      result.0.descriptor_count == state.descriptor_count,
    FirmwareExitAction::Reject { code } =>
      code != 0 && result.0.phase == state.phase &&
      result.0.map_attempts == state.map_attempts &&
      result.0.exit_retries == state.exit_retries &&
      result.0.capacity == state.capacity &&
      result.0.map_key == state.map_key &&
      result.0.descriptor_count == state.descriptor_count,
  }
  ens match event {
    FirmwareExitEvent::MapResult {
      status,
      required_size,
      returned_size,
      descriptor_size,
      descriptor_version,
      descriptor_count,
      map_key,
      capacity
    } => match result.1 {
      FirmwareExitAction::Resize { capacity: new_capacity } =>
        state.phase == 0 && state.map_attempts < 8 && status == 1 &&
        capacity == state.capacity && descriptor_size >= 40 &&
        descriptor_size <= 256 && (descriptor_size & 7) == 0 &&
        required_size > capacity && required_size <= 1048064 &&
        returned_size == 0 && descriptor_count == 0 && map_key == 0 &&
        new_capacity == required_size + 512,
      FirmwareExitAction::MapAccepted =>
        state.phase == 0 && state.map_attempts < 8 && status == 0 &&
        capacity == state.capacity && returned_size != 0 &&
        returned_size <= capacity && required_size == returned_size &&
        descriptor_size >= 40 && descriptor_size <= 256 &&
        (descriptor_size & 7) == 0 && descriptor_version == 1 &&
        descriptor_count >= 1 && descriptor_count <= 4096 &&
        returned_size / descriptor_size == descriptor_count &&
        returned_size % descriptor_size == 0 && map_key != 0 &&
        result.0.map_key == map_key &&
        result.0.descriptor_count == descriptor_count,
      FirmwareExitAction::Reacquire => false,
      FirmwareExitAction::ExitAccepted => false,
      FirmwareExitAction::Complete => false,
      FirmwareExitAction::Reject { code } =>
        code == if state.phase != 0 {
          30 as u32
        } else {
          if state.map_attempts >= 8 {
            31 as u32
          } else {
            if status == 1 {
              if capacity != state.capacity || descriptor_size < 40 ||
                 descriptor_size > 256 || (descriptor_size & 7) != 0 ||
                 required_size <= capacity || required_size > 1048064 ||
                 returned_size != 0 || descriptor_count != 0 || map_key != 0 {
                32 as u32
              } else {
                0 as u32
              }
            } else {
              if status == 0 {
                if capacity != state.capacity || returned_size == 0 ||
                   returned_size > capacity || required_size != returned_size ||
                   descriptor_size < 40 || descriptor_size > 256 ||
                   (descriptor_size & 7) != 0 || descriptor_version != 1 ||
                   descriptor_count < 1 || descriptor_count > 4096 ||
                   returned_size / descriptor_size != descriptor_count ||
                   returned_size % descriptor_size != 0 || map_key == 0 {
                  33 as u32
                } else {
                  0 as u32
                }
              } else {
                34 as u32
              }
            }
          }
        },
    },
    FirmwareExitEvent::ExitResult { status, map_key } => match result.1 {
      FirmwareExitAction::Resize { capacity } => false,
      FirmwareExitAction::MapAccepted => false,
      FirmwareExitAction::Reacquire =>
        state.phase == 1 && map_key == state.map_key && status == 2 &&
        state.exit_retries < 4,
      FirmwareExitAction::ExitAccepted =>
        state.phase == 1 && map_key == state.map_key && status == 0,
      FirmwareExitAction::Complete => false,
      FirmwareExitAction::Reject { code } =>
        code == if state.phase != 1 || map_key != state.map_key {
          40 as u32
        } else {
          if status == 2 && state.exit_retries >= 4 {
            41 as u32
          } else {
            if status != 0 && status != 2 { 42 as u32 } else { 0 as u32 }
          }
        },
    },
    FirmwareExitEvent::Finish => match result.1 {
      FirmwareExitAction::Resize { capacity } => false,
      FirmwareExitAction::MapAccepted => false,
      FirmwareExitAction::Reacquire => false,
      FirmwareExitAction::ExitAccepted => false,
      FirmwareExitAction::Complete => state.phase == 2,
      FirmwareExitAction::Reject { code } =>
        code == if state.phase == 2 { 0 as u32 } else { 50 as u32 },
    },
  }
  fx pure
{
  match event {
    FirmwareExitEvent::MapResult {
      status,
      required_size,
      returned_size,
      descriptor_size,
      descriptor_version,
      descriptor_count,
      map_key,
      capacity
    } =>
      if state.phase != 0 {
        (state, FirmwareExitAction::Reject { code: 30 })
      } else {
        if state.map_attempts >= 8 {
          (state, FirmwareExitAction::Reject { code: 31 })
        } else {
          if status == 1 {
            if capacity != state.capacity || descriptor_size < 40 ||
               descriptor_size > 256 || (descriptor_size & 7) != 0 ||
               required_size <= capacity || required_size > 1048064 ||
               returned_size != 0 || descriptor_count != 0 || map_key != 0 {
              (state, FirmwareExitAction::Reject { code: 32 })
            } else {
              (FirmwareExitState {
                phase: 0,
                map_attempts: state.map_attempts + 1,
                exit_retries: state.exit_retries,
                capacity: required_size + 512,
                map_key: 0,
                descriptor_count: 0,
              }, FirmwareExitAction::Resize {
                capacity: required_size + 512
              })
            }
          } else {
            if status == 0 {
              if capacity != state.capacity || returned_size == 0 ||
                 returned_size > capacity || required_size != returned_size ||
                 descriptor_size < 40 || descriptor_size > 256 ||
                 (descriptor_size & 7) != 0 || descriptor_version != 1 ||
                 descriptor_count < 1 || descriptor_count > 4096 ||
                 returned_size / descriptor_size != descriptor_count ||
                 returned_size % descriptor_size != 0 || map_key == 0 {
                (state, FirmwareExitAction::Reject { code: 33 })
              } else {
                (FirmwareExitState {
                  phase: 1,
                  map_attempts: state.map_attempts + 1,
                  exit_retries: state.exit_retries,
                  capacity: state.capacity,
                  map_key: map_key,
                  descriptor_count: descriptor_count,
                }, FirmwareExitAction::MapAccepted)
              }
            } else {
              (state, FirmwareExitAction::Reject { code: 34 })
            }
          }
        }
      },
    FirmwareExitEvent::ExitResult { status, map_key } =>
      if state.phase != 1 || map_key != state.map_key {
        (state, FirmwareExitAction::Reject { code: 40 })
      } else {
        if status == 0 {
          (FirmwareExitState {
            phase: 2,
            map_attempts: state.map_attempts,
            exit_retries: state.exit_retries,
            capacity: state.capacity,
            map_key: state.map_key,
            descriptor_count: state.descriptor_count,
          }, FirmwareExitAction::ExitAccepted)
        } else {
          if status == 2 {
            if state.exit_retries >= 4 {
              (state, FirmwareExitAction::Reject { code: 41 })
            } else {
              (FirmwareExitState {
                phase: 0,
                map_attempts: state.map_attempts,
                exit_retries: state.exit_retries + 1,
                capacity: state.capacity,
                map_key: 0,
                descriptor_count: 0,
              }, FirmwareExitAction::Reacquire)
            }
          } else {
            (state, FirmwareExitAction::Reject { code: 42 })
          }
        }
      },
    FirmwareExitEvent::Finish =>
      if state.phase == 2 {
        (FirmwareExitState {
          phase: 3,
          map_attempts: state.map_attempts,
          exit_retries: state.exit_retries,
          capacity: state.capacity,
          map_key: state.map_key,
          descriptor_count: state.descriptor_count,
        }, FirmwareExitAction::Complete)
      } else {
        (state, FirmwareExitAction::Reject { code: 50 })
      },
  }
}
