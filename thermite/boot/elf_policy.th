struct ElfPolicyState {
  phase: u32,
  expected_headers: u64,
  seen_headers: u64,
  load_segments: u64,
  last_virtual_end: u64,
  entry: u64,
  file_length: u64,
  entry_covered: bool,
} inv phase <= 2 && seen_headers <= expected_headers &&
      load_segments <= seen_headers &&
      (load_segments != 0 || last_virtual_end == 0)

enum ElfPolicyEvent {
  Header {
    magic: u32,
    class: u32,
    data: u32,
    ident_version: u32,
    osabi: u32,
    abi_version: u32,
    elf_type: u32,
    machine: u32,
    version: u32,
    entry: u64,
    program_offset: u64,
    flags: u32,
    header_size: u32,
    program_entry_size: u32,
    program_count: u32,
    file_length: u64,
    digest_valid: bool,
  },
  ProgramHeader {
    segment_type: u32,
    segment_flags: u32,
    file_offset: u64,
    virtual_address: u64,
    physical_address: u64,
    file_size: u64,
    memory_size: u64,
    alignment: u64,
  },
  Finish,
}

enum ElfPolicyAction {
  HeaderAccepted,
  LoadAccepted,
  MetadataAccepted,
  Complete,
  Reject { code: u32 },
}

fn elf_policy_step(state: ElfPolicyState, event: ElfPolicyEvent)
  -> (ElfPolicyState, ElfPolicyAction)
  req true
  ens result.0.phase >= state.phase
  ens result.0.phase <= 2
  ens result.0.seen_headers <= result.0.expected_headers
  ens result.0.load_segments <= result.0.seen_headers
  ens match result.1 {
    ElfPolicyAction::HeaderAccepted =>
      state.phase == 0 && result.0.phase == 1 &&
      result.0.seen_headers == 0 && result.0.load_segments == 0 &&
      result.0.last_virtual_end == 0 && !result.0.entry_covered,
    ElfPolicyAction::LoadAccepted =>
      state.phase == 1 && result.0.phase == 1 &&
      result.0.expected_headers == state.expected_headers &&
      result.0.seen_headers == state.seen_headers + 1 &&
      result.0.load_segments == state.load_segments + 1 &&
      result.0.last_virtual_end > state.last_virtual_end &&
      result.0.entry == state.entry &&
      result.0.file_length == state.file_length,
    ElfPolicyAction::MetadataAccepted =>
      state.phase == 1 && result.0.phase == 1 &&
      result.0.expected_headers == state.expected_headers &&
      result.0.seen_headers == state.seen_headers + 1 &&
      result.0.load_segments == state.load_segments &&
      result.0.last_virtual_end == state.last_virtual_end &&
      result.0.entry == state.entry &&
      result.0.file_length == state.file_length &&
      result.0.entry_covered == state.entry_covered,
    ElfPolicyAction::Complete =>
      state.phase == 1 && result.0.phase == 2 &&
      result.0.expected_headers == state.expected_headers &&
      result.0.seen_headers == state.seen_headers &&
      result.0.load_segments == state.load_segments &&
      result.0.last_virtual_end == state.last_virtual_end &&
      result.0.entry == state.entry &&
      result.0.file_length == state.file_length &&
      result.0.entry_covered == state.entry_covered,
    ElfPolicyAction::Reject { code } =>
      code != 0 && result.0.phase == state.phase &&
      result.0.expected_headers == state.expected_headers &&
      result.0.seen_headers == state.seen_headers &&
      result.0.load_segments == state.load_segments &&
      result.0.last_virtual_end == state.last_virtual_end &&
      result.0.entry == state.entry &&
      result.0.file_length == state.file_length &&
      result.0.entry_covered == state.entry_covered,
  }
  ens match event {
    ElfPolicyEvent::Header {
      magic,
      class,
      data,
      ident_version,
      osabi,
      abi_version,
      elf_type,
      machine,
      version,
      entry,
      program_offset,
      flags,
      header_size,
      program_entry_size,
      program_count,
      file_length,
      digest_valid
    } => match result.1 {
      ElfPolicyAction::HeaderAccepted =>
        state.phase == 0 && magic == 0x464c_457f &&
        class == 2 && data == 1 && ident_version == 1 &&
        osabi == 0 && abi_version == 0 && elf_type == 2 &&
        machine == 62 && version == 1 &&
        entry >= 0xffff_ffff_8000_0000 &&
        entry < 0xffff_ffff_c000_0000 &&
        program_offset == 64 && flags == 0 && header_size == 64 &&
        program_entry_size == 56 && program_count >= 2 &&
        program_count <= 32 && file_length >= 176 &&
        file_length <= 1073741824 &&
        program_offset + (program_count as u64) * 56 <= file_length &&
        digest_valid && result.0.expected_headers == program_count as u64 &&
        result.0.entry == entry && result.0.file_length == file_length,
      ElfPolicyAction::LoadAccepted => false,
      ElfPolicyAction::MetadataAccepted => false,
      ElfPolicyAction::Complete => false,
      ElfPolicyAction::Reject { code } =>
        code == if state.phase != 0 {
          1 as u32
        } else {
          if magic != 0x464c_457f || class != 2 || data != 1 ||
             ident_version != 1 || osabi != 0 || abi_version != 0 ||
             elf_type != 2 || machine != 62 || version != 1 ||
             entry < 0xffff_ffff_8000_0000 ||
             entry >= 0xffff_ffff_c000_0000 ||
             program_offset != 64 || flags != 0 || header_size != 64 ||
             program_entry_size != 56 || program_count < 2 ||
             program_count > 32 || file_length < 176 ||
             file_length > 1073741824 {
            2 as u32
          } else {
            if program_offset + (program_count as u64) * 56 > file_length ||
               !digest_valid {
              3 as u32
            } else {
              0 as u32
            }
          }
        },
    },
    ElfPolicyEvent::ProgramHeader {
      segment_type,
      segment_flags,
      file_offset,
      virtual_address,
      physical_address,
      file_size,
      memory_size,
      alignment
    } => match result.1 {
      ElfPolicyAction::HeaderAccepted => false,
      ElfPolicyAction::LoadAccepted =>
        state.phase == 1 && state.seen_headers < state.expected_headers &&
        segment_type == 1 && segment_flags <= 7 &&
        (segment_flags & 4) == 4 &&
        !((segment_flags & 1) == 1 && (segment_flags & 2) == 2) &&
        file_size <= memory_size && memory_size != 0 &&
        file_offset <= state.file_length &&
        file_size <= state.file_length - file_offset &&
        virtual_address >= 0xffff_ffff_8000_0000 &&
        virtual_address < 0xffff_ffff_c000_0000 &&
        memory_size <= 0xffff_ffff_c000_0000 - virtual_address &&
        physical_address == virtual_address && alignment == 4096 &&
        (file_offset & 4095) == (virtual_address & 4095) &&
        (state.load_segments == 0 ||
         virtual_address >= state.last_virtual_end) &&
        result.0.last_virtual_end == virtual_address + memory_size &&
        result.0.entry_covered ==
          (state.entry_covered ||
           ((segment_flags & 1) == 1 && state.entry >= virtual_address &&
            state.entry < virtual_address + memory_size)),
      ElfPolicyAction::MetadataAccepted =>
        state.phase == 1 && state.seen_headers < state.expected_headers &&
        ((segment_type == 0 && segment_flags == 0 &&
          file_offset == 0 && virtual_address == 0 &&
          physical_address == 0 && file_size == 0 && memory_size == 0 &&
          alignment == 0) ||
         (segment_type == 0x6474_e551 && segment_flags == 6 &&
          file_offset == 0 && virtual_address == 0 &&
          physical_address == 0 && file_size == 0 && memory_size == 0 &&
          (alignment == 0 || alignment == 16)) ||
         (segment_type == 0x6474_e552 && segment_flags == 4 &&
          file_size == memory_size && memory_size != 0 &&
          file_offset <= state.file_length &&
          file_size <= state.file_length - file_offset &&
          virtual_address >= 0xffff_ffff_8000_0000 &&
          virtual_address < 0xffff_ffff_c000_0000 &&
          memory_size <= 0xffff_ffff_c000_0000 - virtual_address &&
          physical_address == virtual_address &&
          (alignment == 1 || alignment == 4096))),
      ElfPolicyAction::Complete => false,
      ElfPolicyAction::Reject { code } =>
        code == if state.phase != 1 {
          10 as u32
        } else {
          if state.seen_headers >= state.expected_headers {
            11 as u32
          } else {
            if segment_type == 1 {
              if segment_flags > 7 || (segment_flags & 4) != 4 ||
                 ((segment_flags & 1) == 1 && (segment_flags & 2) == 2) ||
                 file_size > memory_size || memory_size == 0 ||
                 file_offset > state.file_length ||
                 file_size > state.file_length - file_offset ||
                 virtual_address < 0xffff_ffff_8000_0000 ||
                 virtual_address >= 0xffff_ffff_c000_0000 ||
                 memory_size > 0xffff_ffff_c000_0000 - virtual_address ||
                 physical_address != virtual_address || alignment != 4096 ||
                 (file_offset & 4095) != (virtual_address & 4095) ||
                 (state.load_segments != 0 &&
                  virtual_address < state.last_virtual_end) {
                12 as u32
              } else {
                0 as u32
              }
            } else {
              if !((segment_type == 0 && segment_flags == 0 &&
                    file_offset == 0 && virtual_address == 0 &&
                    physical_address == 0 && file_size == 0 &&
                    memory_size == 0 && alignment == 0) ||
                   (segment_type == 0x6474_e551 && segment_flags == 6 &&
                    file_offset == 0 && virtual_address == 0 &&
                    physical_address == 0 && file_size == 0 &&
                    memory_size == 0 &&
                    (alignment == 0 || alignment == 16)) ||
                   (segment_type == 0x6474_e552 && segment_flags == 4 &&
                    file_size == memory_size && memory_size != 0 &&
                    file_offset <= state.file_length &&
                    file_size <= state.file_length - file_offset &&
                    virtual_address >= 0xffff_ffff_8000_0000 &&
                    virtual_address < 0xffff_ffff_c000_0000 &&
                    memory_size <=
                      0xffff_ffff_c000_0000 - virtual_address &&
                    physical_address == virtual_address &&
                    (alignment == 1 || alignment == 4096))) {
                13 as u32
              } else {
                0 as u32
              }
            }
          }
        },
    },
    ElfPolicyEvent::Finish => match result.1 {
      ElfPolicyAction::HeaderAccepted => false,
      ElfPolicyAction::LoadAccepted => false,
      ElfPolicyAction::MetadataAccepted => false,
      ElfPolicyAction::Complete =>
        state.phase == 1 && state.seen_headers == state.expected_headers &&
        state.load_segments >= 2 && state.entry_covered,
      ElfPolicyAction::Reject { code } =>
        code == if state.phase == 1 &&
                   state.seen_headers == state.expected_headers &&
                   state.load_segments >= 2 && state.entry_covered {
          0 as u32
        } else {
          20 as u32
        },
    },
  }
  fx pure
{
  match event {
    ElfPolicyEvent::Header {
      magic,
      class,
      data,
      ident_version,
      osabi,
      abi_version,
      elf_type,
      machine,
      version,
      entry,
      program_offset,
      flags,
      header_size,
      program_entry_size,
      program_count,
      file_length,
      digest_valid
    } =>
      if state.phase != 0 {
        (state, ElfPolicyAction::Reject { code: 1 })
      } else {
        if magic != 0x464c_457f || class != 2 || data != 1 ||
           ident_version != 1 || osabi != 0 || abi_version != 0 ||
           elf_type != 2 || machine != 62 || version != 1 ||
           entry < 0xffff_ffff_8000_0000 ||
           entry >= 0xffff_ffff_c000_0000 ||
           program_offset != 64 || flags != 0 || header_size != 64 ||
           program_entry_size != 56 || program_count < 2 ||
           program_count > 32 || file_length < 176 ||
           file_length > 1073741824 {
          (state, ElfPolicyAction::Reject { code: 2 })
        } else {
          if program_offset + (program_count as u64) * 56 > file_length ||
             !digest_valid {
            (state, ElfPolicyAction::Reject { code: 3 })
          } else {
            (ElfPolicyState {
              phase: 1,
              expected_headers: program_count as u64,
              seen_headers: 0,
              load_segments: 0,
              last_virtual_end: 0,
              entry: entry,
              file_length: file_length,
              entry_covered: false,
            }, ElfPolicyAction::HeaderAccepted)
          }
        }
      },
    ElfPolicyEvent::ProgramHeader {
      segment_type,
      segment_flags,
      file_offset,
      virtual_address,
      physical_address,
      file_size,
      memory_size,
      alignment
    } =>
      if state.phase != 1 {
        (state, ElfPolicyAction::Reject { code: 10 })
      } else {
        if state.seen_headers >= state.expected_headers {
          (state, ElfPolicyAction::Reject { code: 11 })
        } else {
          if segment_type == 1 {
            if segment_flags > 7 || (segment_flags & 4) != 4 ||
               ((segment_flags & 1) == 1 && (segment_flags & 2) == 2) ||
               file_size > memory_size || memory_size == 0 ||
               file_offset > state.file_length ||
               file_size > state.file_length - file_offset ||
               virtual_address < 0xffff_ffff_8000_0000 ||
               virtual_address >= 0xffff_ffff_c000_0000 ||
               memory_size > 0xffff_ffff_c000_0000 - virtual_address ||
               physical_address != virtual_address || alignment != 4096 ||
               (file_offset & 4095) != (virtual_address & 4095) ||
               (state.load_segments != 0 &&
                virtual_address < state.last_virtual_end) {
              (state, ElfPolicyAction::Reject { code: 12 })
            } else {
              (ElfPolicyState {
                phase: 1,
                expected_headers: state.expected_headers,
                seen_headers: state.seen_headers + 1,
                load_segments: state.load_segments + 1,
                last_virtual_end: virtual_address + memory_size,
                entry: state.entry,
                file_length: state.file_length,
                entry_covered: state.entry_covered ||
                  ((segment_flags & 1) == 1 && state.entry >= virtual_address &&
                   state.entry < virtual_address + memory_size),
              }, ElfPolicyAction::LoadAccepted)
            }
          } else {
            if !((segment_type == 0 && segment_flags == 0 &&
                  file_offset == 0 && virtual_address == 0 &&
                  physical_address == 0 && file_size == 0 &&
                  memory_size == 0 && alignment == 0) ||
                 (segment_type == 0x6474_e551 && segment_flags == 6 &&
                  file_offset == 0 && virtual_address == 0 &&
                  physical_address == 0 && file_size == 0 &&
                  memory_size == 0 &&
                  (alignment == 0 || alignment == 16)) ||
                 (segment_type == 0x6474_e552 && segment_flags == 4 &&
                  file_size == memory_size && memory_size != 0 &&
                  file_offset <= state.file_length &&
                  file_size <= state.file_length - file_offset &&
                  virtual_address >= 0xffff_ffff_8000_0000 &&
                  virtual_address < 0xffff_ffff_c000_0000 &&
                  memory_size <= 0xffff_ffff_c000_0000 - virtual_address &&
                  physical_address == virtual_address &&
                  (alignment == 1 || alignment == 4096))) {
              (state, ElfPolicyAction::Reject { code: 13 })
            } else {
              (ElfPolicyState {
                phase: 1,
                expected_headers: state.expected_headers,
                seen_headers: state.seen_headers + 1,
                load_segments: state.load_segments,
                last_virtual_end: state.last_virtual_end,
                entry: state.entry,
                file_length: state.file_length,
                entry_covered: state.entry_covered,
              }, ElfPolicyAction::MetadataAccepted)
            }
          }
        }
      },
    ElfPolicyEvent::Finish =>
      if state.phase == 1 && state.seen_headers == state.expected_headers &&
         state.load_segments >= 2 && state.entry_covered {
        (ElfPolicyState {
          phase: 2,
          expected_headers: state.expected_headers,
          seen_headers: state.seen_headers,
          load_segments: state.load_segments,
          last_virtual_end: state.last_virtual_end,
          entry: state.entry,
          file_length: state.file_length,
          entry_covered: state.entry_covered,
        }, ElfPolicyAction::Complete)
      } else {
        (state, ElfPolicyAction::Reject { code: 20 })
      },
  }
}
