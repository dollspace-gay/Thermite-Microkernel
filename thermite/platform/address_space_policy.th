struct AddressPlanState {
  phase: u32,
  expected_regions: u64,
  accepted_regions: u64,
  last_virtual_end: u64,
  kernel_virt_end: u64,
  image_virtual_next: u64,
  kernel_phys_start: u64,
  kernel_phys_end: u64,
  image_physical_next: u64,
  saw_text: bool,
  saw_rodata: bool,
  saw_data: bool,
  saw_stack: bool,
} inv phase <= 2 && accepted_regions <= expected_regions &&
      image_virtual_next <= kernel_virt_end &&
      kernel_phys_start <= image_physical_next &&
      image_physical_next <= kernel_phys_end &&
      (accepted_regions != 0 || last_virtual_end == 0) &&
      (saw_rodata == false || saw_text) &&
      (saw_data == false || saw_rodata)

enum AddressPlanEvent {
  Header {
    region_count: u64,
    kernel_phys_start: u64,
    kernel_phys_end: u64,
    kernel_virt_start: u64,
    kernel_virt_end: u64,
    low_guard_unmapped: bool,
    recursive_mapping_absent: bool,
  },
  Region {
    kind: u32,
    virtual_start: u64,
    physical_start: u64,
    length: u64,
    flags: u32,
    guard_before: bool,
    guard_after: bool,
  },
  Finish,
}

enum AddressPlanAction {
  HeaderAccepted,
  RegionAccepted { kind: u32 },
  Complete,
  Reject { code: u32 },
}

fn address_plan_step(state: AddressPlanState, event: AddressPlanEvent)
  -> (AddressPlanState, AddressPlanAction)
  req true
  ens result.0.phase >= state.phase
  ens result.0.phase <= 2
  ens result.0.accepted_regions <= result.0.expected_regions
  ens result.0.image_virtual_next <= result.0.kernel_virt_end
  ens result.0.kernel_phys_start <= result.0.image_physical_next
  ens result.0.image_physical_next <= result.0.kernel_phys_end
  ens match result.1 {
    AddressPlanAction::HeaderAccepted =>
      state.phase == 0 && result.0.phase == 1 &&
      result.0.accepted_regions == 0 && result.0.last_virtual_end == 0 &&
      result.0.image_virtual_next == 0xffff_ffff_8000_0000 &&
      !result.0.saw_text && !result.0.saw_rodata &&
      !result.0.saw_data && !result.0.saw_stack,
    AddressPlanAction::RegionAccepted { kind } =>
      state.phase == 1 && result.0.phase == 1 && kind >= 1 && kind <= 6 &&
      result.0.expected_regions == state.expected_regions &&
      result.0.accepted_regions == state.accepted_regions + 1 &&
      result.0.last_virtual_end > state.last_virtual_end &&
      result.0.kernel_virt_end == state.kernel_virt_end &&
      result.0.kernel_phys_start == state.kernel_phys_start &&
      result.0.kernel_phys_end == state.kernel_phys_end,
    AddressPlanAction::Complete =>
      state.phase == 1 && result.0.phase == 2 &&
      result.0.expected_regions == state.expected_regions &&
      result.0.accepted_regions == state.accepted_regions &&
      result.0.last_virtual_end == state.last_virtual_end &&
      result.0.kernel_virt_end == state.kernel_virt_end &&
      result.0.image_virtual_next == state.image_virtual_next &&
      result.0.kernel_phys_start == state.kernel_phys_start &&
      result.0.kernel_phys_end == state.kernel_phys_end &&
      result.0.image_physical_next == state.image_physical_next &&
      result.0.saw_text == state.saw_text &&
      result.0.saw_rodata == state.saw_rodata &&
      result.0.saw_data == state.saw_data &&
      result.0.saw_stack == state.saw_stack,
    AddressPlanAction::Reject { code } =>
      code != 0 && result.0.phase == state.phase &&
      result.0.expected_regions == state.expected_regions &&
      result.0.accepted_regions == state.accepted_regions &&
      result.0.last_virtual_end == state.last_virtual_end &&
      result.0.kernel_virt_end == state.kernel_virt_end &&
      result.0.image_virtual_next == state.image_virtual_next &&
      result.0.kernel_phys_start == state.kernel_phys_start &&
      result.0.kernel_phys_end == state.kernel_phys_end &&
      result.0.image_physical_next == state.image_physical_next &&
      result.0.saw_text == state.saw_text &&
      result.0.saw_rodata == state.saw_rodata &&
      result.0.saw_data == state.saw_data &&
      result.0.saw_stack == state.saw_stack,
  }
  ens match event {
    AddressPlanEvent::Header {
      region_count,
      kernel_phys_start,
      kernel_phys_end,
      kernel_virt_start,
      kernel_virt_end,
      low_guard_unmapped,
      recursive_mapping_absent
    } => match result.1 {
      AddressPlanAction::HeaderAccepted =>
        state.phase == 0 && region_count >= 4 && region_count <= 64 &&
        kernel_phys_start < kernel_phys_end &&
        (kernel_phys_start & 4095) == 0 &&
        (kernel_phys_end & 4095) == 0 &&
        kernel_phys_end - kernel_phys_start <= 1073741824 &&
        kernel_phys_end <= 0x0010_0000_0000_0000 &&
        kernel_virt_start == 0xffff_ffff_8000_0000 &&
        kernel_virt_end == kernel_virt_start +
                           (kernel_phys_end - kernel_phys_start) &&
        low_guard_unmapped && recursive_mapping_absent &&
        result.0.expected_regions == region_count &&
        result.0.kernel_virt_end == kernel_virt_end &&
        result.0.image_virtual_next == kernel_virt_start &&
        result.0.kernel_phys_start == kernel_phys_start &&
        result.0.kernel_phys_end == kernel_phys_end &&
        result.0.image_physical_next == kernel_phys_start,
      AddressPlanAction::RegionAccepted { kind } => false,
      AddressPlanAction::Complete => false,
      AddressPlanAction::Reject { code } =>
        code == if state.phase != 0 {
          1 as u32
        } else {
          if region_count < 4 || region_count > 64 ||
             kernel_phys_start >= kernel_phys_end ||
             (kernel_phys_start & 4095) != 0 ||
             (kernel_phys_end & 4095) != 0 ||
             kernel_phys_end - kernel_phys_start > 1073741824 ||
             kernel_phys_end > 0x0010_0000_0000_0000 {
            2 as u32
          } else {
            if kernel_virt_start != 0xffff_ffff_8000_0000 ||
               kernel_virt_end != kernel_virt_start +
                                  (kernel_phys_end - kernel_phys_start) ||
               !low_guard_unmapped || !recursive_mapping_absent {
              3 as u32
            } else {
              0 as u32
            }
          }
        },
    },
    AddressPlanEvent::Region {
      kind,
      virtual_start,
      physical_start,
      length,
      flags,
      guard_before,
      guard_after
    } => match result.1 {
      AddressPlanAction::HeaderAccepted => false,
      AddressPlanAction::RegionAccepted { kind: accepted_kind } =>
        state.phase == 1 && state.accepted_regions < state.expected_regions &&
        accepted_kind == kind && kind >= 1 && kind <= 6 && length != 0 &&
        length <= 1073741824 && (length & 4095) == 0 &&
        (virtual_start & 4095) == 0 && (physical_start & 4095) == 0 &&
        physical_start <= 0x0010_0000_0000_0000 &&
        length <= 0x0010_0000_0000_0000 - physical_start &&
        virtual_start <= 0xffff_ffff_ffff_ffff - length &&
        (state.accepted_regions == 0 ||
         virtual_start >= state.last_virtual_end) &&
        flags >= 1 && flags <= 5 &&
        !((flags & 2) == 2 && (flags & 4) == 4) &&
        ((kind == 1 && virtual_start >= 0xffff_8000_0000_0000 &&
          virtual_start + length <= 0xffff_c000_0000_0000 && flags == 3 &&
          physical_start == virtual_start - 0xffff_8000_0000_0000 &&
          !guard_before && !guard_after &&
          (physical_start + length <= state.kernel_phys_start ||
           physical_start >= state.kernel_phys_end)) ||
         (kind == 2 && virtual_start >= 0xffff_c000_0000_0000 &&
          virtual_start + length <= 0xffff_e000_0000_0000 && flags == 3 &&
          !guard_before && !guard_after &&
          (physical_start + length <= state.kernel_phys_start ||
           physical_start >= state.kernel_phys_end)) ||
         (kind == 3 && virtual_start >= 0xffff_e000_0000_0000 &&
          virtual_start + length <= 0xffff_f000_0000_0000 && flags == 3 &&
          guard_before && guard_after &&
          (physical_start + length <= state.kernel_phys_start ||
           physical_start >= state.kernel_phys_end)) ||
         (kind == 4 && virtual_start >= 0xffff_ffff_8000_0000 &&
          virtual_start + length <= 0xffff_ffff_c000_0000 && flags == 5 &&
          !guard_before && !guard_after && !state.saw_text &&
          !state.saw_rodata && !state.saw_data &&
          virtual_start == state.image_virtual_next &&
          length <= state.kernel_virt_end - virtual_start &&
          physical_start == state.image_physical_next &&
          length <= state.kernel_phys_end - physical_start) ||
         (kind == 5 && virtual_start >= 0xffff_ffff_8000_0000 &&
          virtual_start + length <= 0xffff_ffff_c000_0000 && flags == 1 &&
          !guard_before && !guard_after && state.saw_text &&
          !state.saw_rodata && !state.saw_data &&
          virtual_start == state.image_virtual_next &&
          length <= state.kernel_virt_end - virtual_start &&
          physical_start == state.image_physical_next &&
          length <= state.kernel_phys_end - physical_start) ||
         (kind == 6 && virtual_start >= 0xffff_ffff_8000_0000 &&
          virtual_start + length <= 0xffff_ffff_c000_0000 && flags == 3 &&
          !guard_before && !guard_after && state.saw_text &&
          state.saw_rodata && !state.saw_data &&
          virtual_start == state.image_virtual_next &&
          length <= state.kernel_virt_end - virtual_start &&
          physical_start == state.image_physical_next &&
          length <= state.kernel_phys_end - physical_start)) &&
        result.0.last_virtual_end == virtual_start + length &&
        ((kind >= 4 &&
          result.0.image_virtual_next == virtual_start + length) ||
         (kind < 4 &&
          result.0.image_virtual_next == state.image_virtual_next)) &&
        ((kind >= 4 &&
          result.0.image_physical_next == physical_start + length) ||
         (kind < 4 &&
          result.0.image_physical_next == state.image_physical_next)) &&
        result.0.saw_text == (state.saw_text || kind == 4) &&
        result.0.saw_rodata == (state.saw_rodata || kind == 5) &&
        result.0.saw_data == (state.saw_data || kind == 6) &&
        result.0.saw_stack == (state.saw_stack || kind == 3),
      AddressPlanAction::Complete => false,
      AddressPlanAction::Reject { code } =>
        code == if state.phase != 1 {
          10 as u32
        } else {
          if state.accepted_regions >= state.expected_regions {
            11 as u32
          } else {
            if kind < 1 || kind > 6 || length == 0 ||
               length > 1073741824 || (length & 4095) != 0 ||
               (virtual_start & 4095) != 0 ||
               (physical_start & 4095) != 0 ||
               physical_start > 0x0010_0000_0000_0000 ||
               length > 0x0010_0000_0000_0000 - physical_start ||
               virtual_start > 0xffff_ffff_ffff_ffff - length ||
               (state.accepted_regions != 0 &&
                virtual_start < state.last_virtual_end) ||
               flags < 1 || flags > 5 ||
               ((flags & 2) == 2 && (flags & 4) == 4) {
              12 as u32
            } else {
              if !((kind == 1 &&
                    virtual_start >= 0xffff_8000_0000_0000 &&
                    virtual_start + length <= 0xffff_c000_0000_0000 &&
                    physical_start == virtual_start - 0xffff_8000_0000_0000 &&
                    flags == 3 && !guard_before && !guard_after &&
                    (physical_start + length <= state.kernel_phys_start ||
                     physical_start >= state.kernel_phys_end)) ||
                   (kind == 2 &&
                    virtual_start >= 0xffff_c000_0000_0000 &&
                    virtual_start + length <= 0xffff_e000_0000_0000 &&
                    flags == 3 && !guard_before && !guard_after &&
                    (physical_start + length <= state.kernel_phys_start ||
                     physical_start >= state.kernel_phys_end)) ||
                   (kind == 3 &&
                    virtual_start >= 0xffff_e000_0000_0000 &&
                    virtual_start + length <= 0xffff_f000_0000_0000 &&
                    flags == 3 && guard_before && guard_after &&
                    (physical_start + length <= state.kernel_phys_start ||
                     physical_start >= state.kernel_phys_end)) ||
                   (kind == 4 &&
                    virtual_start >= 0xffff_ffff_8000_0000 &&
                    virtual_start + length <= 0xffff_ffff_c000_0000 &&
                    flags == 5 && !guard_before && !guard_after &&
                    !state.saw_text && !state.saw_rodata && !state.saw_data &&
                    virtual_start == state.image_virtual_next &&
                    length <= state.kernel_virt_end - virtual_start &&
                    physical_start == state.image_physical_next &&
                    length <= state.kernel_phys_end - physical_start) ||
                   (kind == 5 &&
                    virtual_start >= 0xffff_ffff_8000_0000 &&
                    virtual_start + length <= 0xffff_ffff_c000_0000 &&
                    flags == 1 && !guard_before && !guard_after &&
                    state.saw_text && !state.saw_rodata && !state.saw_data &&
                    virtual_start == state.image_virtual_next &&
                    length <= state.kernel_virt_end - virtual_start &&
                    physical_start == state.image_physical_next &&
                    length <= state.kernel_phys_end - physical_start) ||
                   (kind == 6 &&
                    virtual_start >= 0xffff_ffff_8000_0000 &&
                    virtual_start + length <= 0xffff_ffff_c000_0000 &&
                    flags == 3 && !guard_before && !guard_after &&
                    state.saw_text && state.saw_rodata && !state.saw_data &&
                    virtual_start == state.image_virtual_next &&
                    length <= state.kernel_virt_end - virtual_start &&
                    physical_start == state.image_physical_next &&
                    length <= state.kernel_phys_end - physical_start)) {
                13 as u32
              } else {
                0 as u32
              }
            }
          }
        },
    },
    AddressPlanEvent::Finish => match result.1 {
      AddressPlanAction::HeaderAccepted => false,
      AddressPlanAction::RegionAccepted { kind } => false,
      AddressPlanAction::Complete =>
        state.phase == 1 && state.accepted_regions == state.expected_regions &&
        state.saw_text && state.saw_rodata && state.saw_data &&
        state.saw_stack &&
        state.image_virtual_next == state.kernel_virt_end &&
        state.image_physical_next == state.kernel_phys_end,
      AddressPlanAction::Reject { code } =>
        code == if state.phase == 1 &&
                   state.accepted_regions == state.expected_regions &&
                   state.saw_text && state.saw_rodata && state.saw_data &&
                   state.saw_stack &&
                   state.image_virtual_next == state.kernel_virt_end &&
                   state.image_physical_next == state.kernel_phys_end {
          0 as u32
        } else {
          20 as u32
        },
    },
  }
  fx pure
{
  match event {
    AddressPlanEvent::Header {
      region_count,
      kernel_phys_start,
      kernel_phys_end,
      kernel_virt_start,
      kernel_virt_end,
      low_guard_unmapped,
      recursive_mapping_absent
    } =>
      if state.phase != 0 {
        (state, AddressPlanAction::Reject { code: 1 })
      } else {
        if region_count < 4 || region_count > 64 ||
           kernel_phys_start >= kernel_phys_end ||
           (kernel_phys_start & 4095) != 0 ||
           (kernel_phys_end & 4095) != 0 ||
           kernel_phys_end - kernel_phys_start > 1073741824 ||
           kernel_phys_end > 0x0010_0000_0000_0000 {
          (state, AddressPlanAction::Reject { code: 2 })
        } else {
          if kernel_virt_start != 0xffff_ffff_8000_0000 ||
             kernel_virt_end != kernel_virt_start +
                                (kernel_phys_end - kernel_phys_start) ||
             !low_guard_unmapped || !recursive_mapping_absent {
            (state, AddressPlanAction::Reject { code: 3 })
          } else {
            (AddressPlanState {
              phase: 1,
              expected_regions: region_count,
              accepted_regions: 0,
              last_virtual_end: 0,
              kernel_virt_end: kernel_virt_end,
              image_virtual_next: kernel_virt_start,
              kernel_phys_start: kernel_phys_start,
              kernel_phys_end: kernel_phys_end,
              image_physical_next: kernel_phys_start,
              saw_text: false,
              saw_rodata: false,
              saw_data: false,
              saw_stack: false,
            }, AddressPlanAction::HeaderAccepted)
          }
        }
      },
    AddressPlanEvent::Region {
      kind,
      virtual_start,
      physical_start,
      length,
      flags,
      guard_before,
      guard_after
    } =>
      if state.phase != 1 {
        (state, AddressPlanAction::Reject { code: 10 })
      } else {
        if state.accepted_regions >= state.expected_regions {
          (state, AddressPlanAction::Reject { code: 11 })
        } else {
          if kind < 1 || kind > 6 || length == 0 ||
             length > 1073741824 || (length & 4095) != 0 ||
             (virtual_start & 4095) != 0 ||
             (physical_start & 4095) != 0 ||
             physical_start > 0x0010_0000_0000_0000 ||
             length > 0x0010_0000_0000_0000 - physical_start ||
             virtual_start > 0xffff_ffff_ffff_ffff - length ||
             (state.accepted_regions != 0 &&
              virtual_start < state.last_virtual_end) ||
             flags < 1 || flags > 5 ||
             ((flags & 2) == 2 && (flags & 4) == 4) {
            (state, AddressPlanAction::Reject { code: 12 })
          } else {
            if !((kind == 1 &&
                  virtual_start >= 0xffff_8000_0000_0000 &&
                  virtual_start + length <= 0xffff_c000_0000_0000 &&
                  physical_start == virtual_start - 0xffff_8000_0000_0000 &&
                  flags == 3 && !guard_before && !guard_after &&
                  (physical_start + length <= state.kernel_phys_start ||
                   physical_start >= state.kernel_phys_end)) ||
                 (kind == 2 &&
                  virtual_start >= 0xffff_c000_0000_0000 &&
                  virtual_start + length <= 0xffff_e000_0000_0000 &&
                  flags == 3 && !guard_before && !guard_after &&
                  (physical_start + length <= state.kernel_phys_start ||
                   physical_start >= state.kernel_phys_end)) ||
                 (kind == 3 &&
                  virtual_start >= 0xffff_e000_0000_0000 &&
                  virtual_start + length <= 0xffff_f000_0000_0000 &&
                  flags == 3 && guard_before && guard_after &&
                  (physical_start + length <= state.kernel_phys_start ||
                   physical_start >= state.kernel_phys_end)) ||
                 (kind == 4 &&
                  virtual_start >= 0xffff_ffff_8000_0000 &&
                  virtual_start + length <= 0xffff_ffff_c000_0000 &&
                  flags == 5 && !guard_before && !guard_after &&
                  !state.saw_text && !state.saw_rodata && !state.saw_data &&
                  virtual_start == state.image_virtual_next &&
                  length <= state.kernel_virt_end - virtual_start &&
                  physical_start == state.image_physical_next &&
                  length <= state.kernel_phys_end - physical_start) ||
                 (kind == 5 &&
                  virtual_start >= 0xffff_ffff_8000_0000 &&
                  virtual_start + length <= 0xffff_ffff_c000_0000 &&
                  flags == 1 && !guard_before && !guard_after &&
                  state.saw_text && !state.saw_rodata && !state.saw_data &&
                  virtual_start == state.image_virtual_next &&
                  length <= state.kernel_virt_end - virtual_start &&
                  physical_start == state.image_physical_next &&
                  length <= state.kernel_phys_end - physical_start) ||
                 (kind == 6 &&
                  virtual_start >= 0xffff_ffff_8000_0000 &&
                  virtual_start + length <= 0xffff_ffff_c000_0000 &&
                  flags == 3 && !guard_before && !guard_after &&
                  state.saw_text && state.saw_rodata && !state.saw_data &&
                  virtual_start == state.image_virtual_next &&
                  length <= state.kernel_virt_end - virtual_start &&
                  physical_start == state.image_physical_next &&
                  length <= state.kernel_phys_end - physical_start)) {
              (state, AddressPlanAction::Reject { code: 13 })
            } else {
              (AddressPlanState {
                phase: 1,
                expected_regions: state.expected_regions,
                accepted_regions: state.accepted_regions + 1,
                last_virtual_end: virtual_start + length,
                kernel_virt_end: state.kernel_virt_end,
                image_virtual_next: if kind >= 4 {
                  virtual_start + length
                } else {
                  state.image_virtual_next
                },
                kernel_phys_start: state.kernel_phys_start,
                kernel_phys_end: state.kernel_phys_end,
                image_physical_next: if kind >= 4 {
                  physical_start + length
                } else {
                  state.image_physical_next
                },
                saw_text: state.saw_text || kind == 4,
                saw_rodata: state.saw_rodata || kind == 5,
                saw_data: state.saw_data || kind == 6,
                saw_stack: state.saw_stack || kind == 3,
              }, AddressPlanAction::RegionAccepted { kind: kind })
            }
          }
        }
      },
    AddressPlanEvent::Finish =>
      if state.phase == 1 && state.accepted_regions == state.expected_regions &&
         state.saw_text && state.saw_rodata && state.saw_data &&
         state.saw_stack &&
         state.image_virtual_next == state.kernel_virt_end &&
         state.image_physical_next == state.kernel_phys_end {
        (AddressPlanState {
          phase: 2,
          expected_regions: state.expected_regions,
          accepted_regions: state.accepted_regions,
          last_virtual_end: state.last_virtual_end,
          kernel_virt_end: state.kernel_virt_end,
          image_virtual_next: state.image_virtual_next,
          kernel_phys_start: state.kernel_phys_start,
          kernel_phys_end: state.kernel_phys_end,
          image_physical_next: state.image_physical_next,
          saw_text: state.saw_text,
          saw_rodata: state.saw_rodata,
          saw_data: state.saw_data,
          saw_stack: state.saw_stack,
        }, AddressPlanAction::Complete)
      } else {
        (state, AddressPlanAction::Reject { code: 20 })
      },
  }
}
